{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/chapters/:chapterId",
      "destination": "/chapters/:chapterId/index.html"
    },
    {
      "source": "**",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/**",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
